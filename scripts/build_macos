#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
project_dir="$(cd -- "$script_dir/.." && pwd)"
readonly project_dir

output_path="build/Sygnature-macOS.dmg"
architecture="arm64"
flutter_args=()

usage() {
  cat <<'EOF'
Usage: scripts/build_macos [--arch arm64|x86_64] [--output PATH] [FLUTTER_BUILD_OPTIONS]

Builds, Developer ID signs, and notarizes a compressed DMG for testers.
Requires MACOS_SIGNING_IDENTITY, APPLE_TEAM_ID, and NOTARYTOOL_PROFILE.
Optionally set MACOS_SIGNING_KEYCHAIN to an isolated signing Keychain.
Additional options are passed to `flutter build macos`, for example:

  scripts/build_macos --no-pub --build-name 0.9.1 --build-number 3
  scripts/build_macos --arch x86_64 --output build/Sygnature-macOS-x86_64.dmg
EOF
}

while (($# > 0)); do
  case "$1" in
    --arch)
      if (($# < 2)); then
        echo "error: --arch requires arm64 or x86_64" >&2
        exit 2
      fi
      architecture="$2"
      shift
      ;;
    --arch=*)
      architecture="${1#*=}"
      ;;
    --output)
      if (($# < 2)); then
        echo "error: --output requires a path" >&2
        exit 2
      fi
      output_path="$2"
      shift
      ;;
    --output=*)
      output_path="${1#*=}"
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      flutter_args+=("$1")
      ;;
  esac
  shift
done

if [[ "$architecture" != "arm64" && "$architecture" != "x86_64" ]]; then
  echo "error: --arch must be arm64 or x86_64" >&2
  exit 2
fi

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "error: macOS is required to build a DMG" >&2
  exit 1
fi

if [[ -z "$output_path" || "$output_path" != *.dmg ]]; then
  echo "error: --output must be a non-empty .dmg path" >&2
  exit 2
fi

for variable in MACOS_SIGNING_IDENTITY APPLE_TEAM_ID NOTARYTOOL_PROFILE; do
  if [[ -z "${!variable:-}" ]]; then
    echo "error: required signing configuration missing: $variable" >&2
    exit 1
  fi
done

for tool in flutter xcodebuild codesign hdiutil ditto xcrun python3; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "error: required command not found: $tool" >&2
    exit 1
  fi
done

cd -- "$project_dir"
if [[ "$output_path" != /* ]]; then
  output_path="$project_dir/$output_path"
fi

# Compile without signing, then sign each component with the Developer ID below.
# Bash 3.2 treats an empty array as unset under `set -u`.
flutter build macos --release --config-only ${flutter_args[@]+"${flutter_args[@]}"}
xcodebuild \
  -quiet \
  -workspace "$project_dir/macos/Runner.xcworkspace" \
  -scheme Runner \
  -configuration Release \
  -derivedDataPath "$project_dir/build/macos" \
  -destination "generic/platform=macOS" \
  CODE_SIGNING_ALLOWED=NO \
  CODE_SIGN_IDENTITY= \
  CODE_SIGN_STYLE=Manual \
  DEVELOPMENT_TEAM= \
  PROVISIONING_PROFILE_SPECIFIER= \
  ENABLE_HARDENED_RUNTIME=YES \
  CODE_SIGN_INJECT_BASE_ENTITLEMENTS=NO \
  ONLY_ACTIVE_ARCH=YES \
  ARCHS="$architecture"

readonly app_path="$project_dir/build/macos/Build/Products/Release/sygnature.app"
if [[ ! -d "$app_path" ]]; then
  echo "error: Flutter did not create the expected app: $app_path" >&2
  exit 1
fi

temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/sygnature-macos.XXXXXX")"
readonly temporary_dir
trap 'rm -rf -- "$temporary_dir"' EXIT

readonly staging_dir="$temporary_dir/dmg"
readonly temporary_dmg="$temporary_dir/Sygnature-macOS.dmg"
mkdir -p -- "$staging_dir" "$(dirname -- "$output_path")"
ditto "$app_path" "$staging_dir/Sygnature.app"
python3 "$script_dir/sign_macos.py" "$staging_dir/Sygnature.app" \
  "$project_dir/macos/Runner/Release.entitlements"

notary_args=(--keychain-profile "$NOTARYTOOL_PROFILE")
signing_args=(--sign "$MACOS_SIGNING_IDENTITY" --timestamp)
if [[ -n "${MACOS_SIGNING_KEYCHAIN:-}" ]]; then
  notary_args+=(--keychain "$MACOS_SIGNING_KEYCHAIN")
  signing_args+=(--keychain "$MACOS_SIGNING_KEYCHAIN")
fi

notarize() {
  local artifact="$1" result="$2"
  # Parse status even when submit exits successfully: only Accepted may ship.
  xcrun notarytool submit "$artifact" "${notary_args[@]}" --wait \
    --timeout 20m --output-format json > "$result"
  python3 - "$result" <<'PY'
import json
import sys
with open(sys.argv[1]) as stream:
    result = json.load(stream)
print("Notarization:", result.get("id"), result.get("status"))
if result.get("status") != "Accepted":
    raise SystemExit("Apple did not accept the submission; no DMG will be published.")
PY
}

# Staple the app before packaging so the installed app also has an offline ticket.
ditto -c -k --keepParent "$staging_dir/Sygnature.app" "$temporary_dir/app.zip"
notarize "$temporary_dir/app.zip" "$temporary_dir/app-notarization.json"
xcrun stapler staple "$staging_dir/Sygnature.app"
xcrun stapler validate "$staging_dir/Sygnature.app"
codesign --verify --deep --strict "$staging_dir/Sygnature.app"
spctl --assess --type execute --verbose=2 "$staging_dir/Sygnature.app"
ln -s /Applications "$staging_dir/Applications"

hdiutil create \
  -quiet \
  -volname Sygnature \
  -srcfolder "$staging_dir" \
  -ov \
  -format UDZO \
  "$temporary_dmg"

codesign "${signing_args[@]}" "$temporary_dmg"
codesign --verify --strict "$temporary_dmg"
notarize "$temporary_dmg" "$temporary_dir/dmg-notarization.json"
xcrun stapler staple "$temporary_dmg"
xcrun stapler validate "$temporary_dmg"
codesign --verify --strict "$temporary_dmg"
spctl --assess --type open --context context:primary-signature --verbose=2 "$temporary_dmg"

# Verify the app actually packaged in the final image, not just the staging copy.
mkdir "$temporary_dir/mounted"
hdiutil attach -quiet -readonly -nobrowse -mountpoint "$temporary_dir/mounted" "$temporary_dmg"
trap 'hdiutil detach -quiet "$temporary_dir/mounted" || true; rm -rf -- "$temporary_dir"' EXIT
codesign --verify --deep --strict "$temporary_dir/mounted/Sygnature.app"
xcrun stapler validate "$temporary_dir/mounted/Sygnature.app"
spctl --assess --type execute --verbose=2 "$temporary_dir/mounted/Sygnature.app"
hdiutil detach -quiet "$temporary_dir/mounted"
trap 'rm -rf -- "$temporary_dir"' EXIT

mv -f -- "$temporary_dmg" "$output_path"

echo "macOS DMG: $output_path"
echo "Architecture: $architecture"
echo "Developer ID signature, hardened runtime, notarization, stapling, and Gatekeeper checks passed."
