#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
project_dir="$(cd -- "$script_dir/.." && pwd)"
readonly project_dir

output_path="build/Sygnature-macOS.dmg"
architecture="arm64"
flutter_args=()

usage() {
  cat <<'EOF'
Usage: scripts/build_macos [--arch arm64|x86_64] [--output PATH] [FLUTTER_BUILD_OPTIONS]

Builds the macOS release app and packages it in a compressed DMG for testers.
Uses ad-hoc signing; no Apple signing certificate or provisioning profile is
required. Testers may need to allow the app in Privacy & Security on first launch.
Additional options are passed to `flutter build macos`, for example:

  scripts/build_macos --no-pub --build-name 0.9.1 --build-number 3
  scripts/build_macos --arch x86_64 --output build/Sygnature-macOS-x86_64.dmg
EOF
}

while (($# > 0)); do
  case "$1" in
    --arch)
      if (($# < 2)); then
        echo "error: --arch requires arm64 or x86_64" >&2
        exit 2
      fi
      architecture="$2"
      shift
      ;;
    --arch=*)
      architecture="${1#*=}"
      ;;
    --output)
      if (($# < 2)); then
        echo "error: --output requires a path" >&2
        exit 2
      fi
      output_path="$2"
      shift
      ;;
    --output=*)
      output_path="${1#*=}"
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      flutter_args+=("$1")
      ;;
  esac
  shift
done

if [[ "$architecture" != "arm64" && "$architecture" != "x86_64" ]]; then
  echo "error: --arch must be arm64 or x86_64" >&2
  exit 2
fi

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "error: macOS is required to build a DMG" >&2
  exit 1
fi

if [[ -z "$output_path" || "$output_path" != *.dmg ]]; then
  echo "error: --output must be a non-empty .dmg path" >&2
  exit 2
fi

for tool in flutter xcodebuild codesign hdiutil ditto; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "error: required command not found: $tool" >&2
    exit 1
  fi
done

cd -- "$project_dir"
if [[ "$output_path" != /* ]]; then
  output_path="$project_dir/$output_path"
fi

# Use ad-hoc signing while preserving the app's sandbox and network entitlements.
# Hardened runtime library validation rejects frameworks without a Team ID.
# Bash 3.2 treats an empty array as unset under `set -u`.
flutter build macos --release --config-only ${flutter_args[@]+"${flutter_args[@]}"}
xcodebuild \
  -quiet \
  -workspace "$project_dir/macos/Runner.xcworkspace" \
  -scheme Runner \
  -configuration Release \
  -derivedDataPath "$project_dir/build/macos" \
  -destination "generic/platform=macOS" \
  CODE_SIGN_IDENTITY=- \
  CODE_SIGN_STYLE=Manual \
  DEVELOPMENT_TEAM= \
  PROVISIONING_PROFILE_SPECIFIER= \
  ENABLE_HARDENED_RUNTIME=NO \
  ONLY_ACTIVE_ARCH=YES \
  ARCHS="$architecture"

readonly app_path="$project_dir/build/macos/Build/Products/Release/sygnature.app"
if [[ ! -d "$app_path" ]]; then
  echo "error: Flutter did not create the expected app: $app_path" >&2
  exit 1
fi

temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/sygnature-macos.XXXXXX")"
readonly temporary_dir
trap 'rm -rf -- "$temporary_dir"' EXIT

readonly staging_dir="$temporary_dir/dmg"
readonly temporary_dmg="$temporary_dir/Sygnature-macOS.dmg"
mkdir -p -- "$staging_dir" "$(dirname -- "$output_path")"
ditto "$app_path" "$staging_dir/Sygnature.app"
# Xcode can preserve a development signature on cached plugin frameworks even
# when the runner is built ad hoc. Re-sign the complete staged bundle without
# hardened runtime, since ad-hoc signatures cannot satisfy its Team ID checks.
codesign \
  --force \
  --deep \
  --sign - \
  --options 0 \
  --entitlements "$project_dir/macos/Runner/Release.entitlements" \
  "$staging_dir/Sygnature.app"
codesign --verify --deep --strict "$staging_dir/Sygnature.app"
ln -s /Applications "$staging_dir/Applications"

hdiutil create \
  -quiet \
  -volname Sygnature \
  -srcfolder "$staging_dir" \
  -ov \
  -format UDZO \
  "$temporary_dmg"

mv -f -- "$temporary_dmg" "$output_path"

echo "macOS DMG: $output_path"
echo "Architecture: $architecture"
echo "Note: this ad-hoc signed build is not notarized. If blocked on first launch, use System Settings > Privacy & Security > Open Anyway."
