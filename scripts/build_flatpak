#!/usr/bin/env bash

set -euo pipefail

readonly app_id="network.noosphere.sygnature"
readonly runtime_branch="26.08"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
project_dir="$(cd -- "$script_dir/.." && pwd)"
readonly project_dir

mode="release"
share_data="no"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --release) mode="release" ;;
    --debug) mode="debug" ;;
    --share-data) share_data="yes" ;;
    *)
      echo "usage: $0 [--release|--debug] [--share-data]" >&2
      exit 2
      ;;
  esac
  shift
done
if [ "$mode" = "release" ] && [ "$share_data" = "yes" ]; then
  echo "error: --share-data only applies to --debug builds" >&2
  exit 2
fi

if [ "$mode" = "debug" ]; then
  # Debug builds compile the Rust crates with the dev profile, where panics
  # unwind instead of aborting, so an iroh panic surfaces as a Dart error
  # instead of a silent process kill. The generated manifest lives next to the
  # release one so its relative source paths (`..`, `rustup`) still resolve.
  manifest="$project_dir/.flatpak/$app_id.Debug.yml"
  if [ "$share_data" = "yes" ]; then
    # Keep the release app-id: Flatpak keys ~/.var/app/<app-id> (and therefore
    # XDG_*_HOME) off the app-id, so this is the only way for the debug build
    # to run on the release app's data directory.
    effective_app_id="$app_id"
    sed \
      -e "1i # Generated by scripts/build_flatpak --debug --share-data; app-id intentionally unchanged so the debug build shares ~/.var/app/$app_id with the release build." \
      -e "s/--release/--debug/" \
      -e "s|/release/bundle/|/debug/bundle/|" \
      "$project_dir/.flatpak/$app_id.yml" >"$manifest"
  else
    effective_app_id="$app_id.Debug"
    sed \
      -e "s/^app-id: .*/app-id: $effective_app_id/" \
      -e "s/--release/--debug/" \
      -e "s|/release/bundle/|/debug/bundle/|" \
      "$project_dir/.flatpak/$app_id.yml" >"$manifest"
  fi
  output_dir="$project_dir/build/flatpak-debug"
else
  effective_app_id="$app_id"
  manifest="$project_dir/.flatpak/$app_id.yml"
  output_dir="$project_dir/build/flatpak"
fi
readonly effective_app_id manifest output_dir
readonly build_dir="$output_dir/build"
readonly repo_dir="$output_dir/repo"
readonly bundle="$output_dir/$effective_app_id.flatpak"
readonly state_dir="$project_dir/.flatpak-builder"

for tool in flatpak flatpak-builder; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "error: required command not found: $tool" >&2
    exit 1
  fi
done

if ! flatpak remotes --user --columns=name | grep -Fxq flathub; then
  flatpak remote-add --user --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo
fi

for runtime in org.freedesktop.Platform org.freedesktop.Sdk; do
  if ! flatpak info --user "$runtime//$runtime_branch" >/dev/null 2>&1; then
    flatpak install --user --noninteractive flathub "$runtime//$runtime_branch"
  fi
done

mkdir -p "$output_dir" "$repo_dir"

# Debug builds keep the build dir so repeated runs only rebuild what changed,
# but a build dir left behind by an interrupted run must be cleaned first.
clean_args=(--force-clean --delete-build-dirs)
if [ "$mode" = "debug" ]; then
  clean_args=()
  if [ -d "$build_dir" ] && [ ! -f "$output_dir/.build-ok" ]; then
    clean_args=(--force-clean)
  fi
fi

flatpak-builder \
  --user \
  "${clean_args[@]}" \
  --ccache \
  --disable-rofiles-fuse \
  --state-dir="$state_dir" \
  --install-deps-from=flathub \
  --repo="$repo_dir" \
  "$build_dir" \
  "$manifest"

temporary_bundle="$bundle.tmp"
trap 'rm -f -- "$temporary_bundle"' EXIT
flatpak build-bundle "$repo_dir" "$temporary_bundle" "$effective_app_id"
mv -f -- "$temporary_bundle" "$bundle"
trap - EXIT
touch "$output_dir/.build-ok"

if [ "$share_data" = "yes" ]; then
  echo "Share-data debug build: app-id kept as $app_id, so it runs on the release"
  echo "app's per-app dir (~/.var/app/$app_id). Run without installing:"
  echo "  flatpak-builder --run --disable-rofiles-fuse --state-dir=$state_dir --env=RUST_BACKTRACE=1 $build_dir $manifest"
  echo "Or install it over the release app:"
  echo "  flatpak remote-add --user --if-not-exists sygnature-debug $repo_dir"
  echo "  flatpak install --user --reinstall sygnature-debug $app_id"
  echo "Do not run the release and debug builds at the same time."
fi

echo "Flatpak bundle ($mode): $bundle"
